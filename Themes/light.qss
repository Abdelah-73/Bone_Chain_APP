/* ============================================
   LIGHT THEME — BoneChain Fertilizer OS
   Colors  : bg=#FFFFFF  panel=#F1F5F9  text=#0F172A  accent=#2563EB
   ============================================ */

/* ---------- Global ---------- */
QMainWindow, QDialog, QWidget {
    background-color: #FFFFFF;
    color: #0F172A;
    font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
}

/* ---------- Labels ---------- */
QLabel {
    color: #0F172A;
    border: none;
    background-color: transparent;
}

/* ---------- Line Edits ---------- */
QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #E2E8F0;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    color: #0F172A;
}
QLineEdit:focus {
    border: 2px solid #2563EB;
    background-color: #FAFBFC;
}
QLineEdit:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
}

/* ---------- Push Buttons ---------- */
QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #1D4ED8;
}
QPushButton:pressed {
    background-color: #1E40AF;
}
QPushButton:disabled {
    background-color: #CBD5E1;
    color: #94A3B8;
}

/* Danger role — used for Delete / Cancel */
QPushButton[role="danger"] {
    background-color: #EF4444;
}
QPushButton[role="danger"]:hover {
    background-color: #DC2626;
}
QPushButton[role="danger"]:pressed {
    background-color: #B91C1C;
}

/* ---------- Tables ---------- */
QTableWidget, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    gridline-color: #E2E8F0;
    selection-background-color: #DBEAFE;
    selection-color: #1E40AF;
    font-size: 13px;
    outline: none;
}
QHeaderView::section {
    background-color: #F1F5F9;
    color: #475569;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #CBD5E1;
    font-weight: bold;
    font-size: 13px;
}
QTableWidget::item {
    padding: 5px;
    border: none;
}
QTableWidget::item:selected {
    background-color: #DBEAFE;
    color: #1E40AF;
}

/* ---------- Combo Box ---------- */
QComboBox {
    background-color: #FFFFFF;
    border: 2px solid #E2E8F0;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #0F172A;
    min-height: 20px;
}
QComboBox:hover {
    border: 2px solid #2563EB;
}
QComboBox::drop-down {
    border: none;
    width: 30px;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    selection-background-color: #DBEAFE;
    selection-color: #1E40AF;
    outline: none;
}

/* ---------- Tab Widget ---------- */
QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}
QTabBar::tab {
    background-color: #F1F5F9;
    color: #64748B;
    padding: 10px 20px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: bold;
    font-size: 13px;
}
QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #2563EB;
}
QTabBar::tab:hover:!selected {
    background-color: #E2E8F0;
}

/* ---------- Progress Bar ---------- */
QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #0F172A;
    font-size: 12px;
    font-weight: bold;
    height: 20px;
}
QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 6px;
}

/* ---------- Group Box ---------- */
QGroupBox {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    font-weight: bold;
    color: #0F172A;
}
QGroupBox::title {
    subcontrol-origin: margin;
    padding: 0 8px;
    color: #0F172A;
}

/* ---------- Frame ---------- */
QFrame {
    border: none;
    color: #0F172A;
    background-color: transparent;
}

/* ---------- Menu / Menu Bar ---------- */
QMenuBar {
    background-color: #F1F5F9;
    color: #0F172A;
    border-bottom: 1px solid #E2E8F0;
}
QMenuBar::item:selected {
    background-color: #DBEAFE;
}
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 8px 30px 8px 16px;
    border-radius: 4px;
    color: #0F172A;
}
QMenu::item:selected {
    background-color: #DBEAFE;
    color: #1E40AF;
}
QMenu::separator {
    height: 1px;
    background-color: #E2E8F0;
    margin: 4px 8px;
}

/* ---------- Spin Box ---------- */
QSpinBox {
    background-color: #FFFFFF;
    border: 2px solid #E2E8F0;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 14px;
    color: #0F172A;
}
QSpinBox:focus {
    border: 2px solid #2563EB;
}

/* ---------- Text Edit ---------- */
QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 2px solid #E2E8F0;
    border-radius: 8px;
    padding: 8px;
    font-size: 14px;
    color: #0F172A;
}
QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #2563EB;
}

/* ---------- Scroll Bars ---------- */
QScrollBar:vertical {
    background-color: #F1F5F9;
    width: 10px;
    border: none;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background-color: #F1F5F9;
    height: 10px;
    border: none;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    min-width: 30px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---------- Message Box ---------- */
QMessageBox {
    background-color: #FFFFFF;
}
QMessageBox QLabel {
    color: #0F172A;
}
QMessageBox QPushButton {
    min-width: 80px;
    padding: 8px 20px;
}

/* ---------- Tool Tip ---------- */
QToolTip {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
}
